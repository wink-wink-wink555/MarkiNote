# Optional local overrides. Copy to .env, then start from the repository root:
# docker compose up -d --build --wait

# Image/release identity
MARKINOTE_VERSION=local
MARKINOTE_API_IMAGE=markinote-api
MARKINOTE_GATEWAY_IMAGE=markinote-gateway
# The production overlay refuses tags and requires two registry manifest
# digests. Keep these unset for local builds; fill them from the successful
# release workflow/registry metadata before a production preflight.
# MARKINOTE_API_DIGEST=sha256:<64-lowercase-hex-characters>
# MARKINOTE_GATEWAY_DIGEST=sha256:<64-lowercase-hex-characters>
MARKINOTE_VOLUME_PREFIX=markinote
# Optional registry/mirror overrides for air-gapped builds. Leave unset to use
# the reviewed defaults in infra/compose.yaml.
# MARKINOTE_PYTHON_BASE_IMAGE=registry.example/python:3.12.13-slim-bookworm
# MARKINOTE_NODE_BASE_IMAGE=registry.example/node:22.17.0-alpine3.21
# MARKINOTE_NGINX_BASE_IMAGE=registry.example/nginx:1.30.4-alpine3.24

# Public listener. Keep loopback for a workstation; production normally uses
# 0.0.0.0 behind a TLS-terminating load balancer or ingress.
MARKINOTE_HTTP_BIND=127.0.0.1
MARKINOTE_HTTP_PORT=8080

# Runtime
MARKINOTE_ENVIRONMENT=development
MARKINOTE_LOG_LEVEL=INFO
MARKINOTE_JSON_LOGS=true
MARKINOTE_METRICS_ENABLED=true
MARKINOTE_TRUSTED_ORIGINS=[]
# Hostnames only (no scheme, path, or port). Production must explicitly include
# the hostname from MARKINOTE_PUBLIC_ORIGIN; retain api/loopback for internal
# Prometheus scrapes and container health checks.
MARKINOTE_TRUSTED_HOSTS=["127.0.0.1","localhost","testserver","api"]

# Set a long random value in every non-loopback deployment. Never commit it.
# Example generator: python -c "import secrets; print(secrets.token_urlsafe(48))"
MARKINOTE_ACCESS_TOKEN=
# Stable session signing key; use a separate random value in production.
MARKINOTE_SECRET_KEY=
MARKINOTE_PUBLIC_ORIGIN=

# Authentication mode. Keep access_token for the backwards-compatible local
# profile. accounts requires the database backend and stores each tenant's
# documents, conversations, journals, backups, and encrypted credentials in SQL.
MARKINOTE_AUTH_MODE=access_token
MARKINOTE_REGISTRATION_ENABLED=false
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MARKINOTE_CREDENTIAL_ENCRYPTION_KEY=
MARKINOTE_EMAIL_VERIFICATION_TTL_SECONDS=1800
MARKINOTE_SMTP_HOST=
MARKINOTE_SMTP_PORT=587
MARKINOTE_SMTP_SECURITY=starttls
MARKINOTE_SMTP_USERNAME=
MARKINOTE_SMTP_PASSWORD=
MARKINOTE_SMTP_SENDER_EMAIL=
MARKINOTE_SMTP_SENDER_NAME=MarkiNote

# The default profile keeps documents on persistent LocalFS volumes, stores
# conversations/agent journals as JSON, and uses SQLite for application state.
# Activate the PostgreSQL conversation backend only after configuring the
# database profile and running the documented migration rehearsal.
MARKINOTE_CONVERSATION_BACKEND=json
MARKINOTE_DATABASE_URL=sqlite:////data/state/markinote.db
MARKINOTE_AUTO_CREATE_DATABASE=true

# Optional PostgreSQL profile
MARKINOTE_POSTGRES_DB=markinote
MARKINOTE_POSTGRES_USER=markinote
MARKINOTE_POSTGRES_PASSWORD=replace-with-a-random-password
MARKINOTE_POSTGRES_PORT=5432

# Optional Redis profile (reserved for distributed coordination/queue work)
MARKINOTE_REDIS_PORT=6379
MARKINOTE_REDIS_URL=redis://redis:6379/0

# Optional observability profile
MARKINOTE_PROMETHEUS_PORT=9090
MARKINOTE_OTLP_GRPC_PORT=4317
MARKINOTE_OTLP_HTTP_PORT=4318
MARKINOTE_OTEL_ENABLED=false
MARKINOTE_OTEL_ENDPOINT=http://otel-collector:4318/v1/traces
MARKINOTE_OTEL_SERVICE_NAME=markinote-api

# Retention and product limits
MARKINOTE_BACKUP_MAX_GROUPS=100
MARKINOTE_BACKUP_MAX_BYTES=268435456
MARKINOTE_TRASH_MAX_ITEMS=500
MARKINOTE_TRASH_MAX_BYTES=1073741824
MARKINOTE_MAX_REQUEST_BYTES=16777216
MARKINOTE_MAX_DOCUMENT_BYTES=2097152
MARKINOTE_MAX_PREVIEW_BYTES=2097152
MARKINOTE_MAX_LIBRARY_BYTES=31457280
MARKINOTE_AI_GENERATE_TITLES=false
# Untrusted provider input and browser-facing SSE are bounded independently.
# Values are bytes except EVENTS and STREAM_SECONDS; all must stay positive.
MARKINOTE_AI_MAX_PROVIDER_FRAME_BYTES=262144
MARKINOTE_AI_MAX_PROVIDER_EVENTS=4096
MARKINOTE_AI_MAX_PROVIDER_BYTES=8388608
MARKINOTE_AI_MAX_CONTENT_BYTES_PER_ROUND=524288
MARKINOTE_AI_MAX_CONTENT_BYTES_TOTAL=1048576
MARKINOTE_AI_MAX_TOOL_ARGUMENTS_BYTES=65536
MARKINOTE_AI_MAX_SSE_EVENT_BYTES=524288
MARKINOTE_AI_MAX_STREAM_SECONDS=600
# Optional server-managed provider credential. Never commit a real value.
# Production should inject it from an external secret manager. This Compose
# baseline passes it as a container environment variable, so Docker host and
# container administrators can inspect it; leave it empty to require the
# per-request, memory-only key supported by the UI.
MARKINOTE_AI_API_KEY=
# Optional co-located or HTTPS FinanceMCP service. The MCP business payload is
# forwarded to the model without an application item-count/response-byte cap.
MARKINOTE_FINANCE_MCP_URL=
MARKINOTE_FINANCE_MCP_TIMEOUT_SECONDS=45
# Safety defaults for local/multi-process use. The production single-writer
# overlay enables these together with a bounded limit; never attest
# SINGLE_WRITER when more than one API replica or worker can write.
MARKINOTE_AGENT_RUN_RECONCILE_ON_STARTUP=false
MARKINOTE_AGENT_RUN_SINGLE_WRITER=false
MARKINOTE_AGENT_RUN_RECONCILE_LIMIT=1000
# CI-internal only. Settings rejects this outside MARKINOTE_ENVIRONMENT=test
# and rejects every origin except the isolated fake-provider container.
MARKINOTE_AI_PROVIDER_FIXTURE_URL=
