ARG NODE_BASE_IMAGE=node:22.17.0-alpine3.21
ARG NGINX_BASE_IMAGE=nginx:1.28.0-alpine

FROM ${NODE_BASE_IMAGE} AS web-builder

ENV CI=true
WORKDIR /build

COPY packages/api-client/package.json packages/api-client/package-lock.json ./packages/api-client/
RUN npm ci --prefix packages/api-client --omit=dev --ignore-scripts
COPY packages/api-client/ ./packages/api-client/

WORKDIR /build/apps/web
COPY apps/web/package.json apps/web/package-lock.json ./
RUN npm ci --ignore-scripts

COPY apps/web/ ./
RUN npm run build


FROM ${NGINX_BASE_IMAGE} AS runtime

ARG VCS_REF="unknown"
ARG BUILD_DATE="unknown"
ARG VERSION="0.0.0-local"
ARG SOURCE_URL="unknown"

LABEL org.opencontainers.image.title="MarkiNote Gateway" \
      org.opencontainers.image.description="Same-origin web gateway for MarkiNote" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${VCS_REF}" \
      org.opencontainers.image.created="${BUILD_DATE}" \
      org.opencontainers.image.source="${SOURCE_URL}" \
      org.opencontainers.image.licenses="MIT"

COPY --chown=101:101 infra/nginx/nginx.conf /etc/nginx/nginx.conf
COPY --chown=101:101 LICENSE /usr/share/licenses/markinote/LICENSE
COPY --from=web-builder --chown=101:101 /build/apps/web/dist /usr/share/nginx/html

USER 101:101
EXPOSE 8080
STOPSIGNAL SIGQUIT
ENTRYPOINT []

HEALTHCHECK --interval=15s --timeout=3s --start-period=10s --retries=3 \
  CMD ["wget", "-q", "-O", "/dev/null", "http://127.0.0.1:8080/gateway-health"]

CMD ["nginx", "-g", "daemon off;"]
